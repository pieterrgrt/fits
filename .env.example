# Kopieer naar .env en vul in. .env komt nooit in git.

# Strava (zie docs/strava.md). Leeg laten = Strava staat uit.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Lokaal: waar de database staat (standaard ./data). In Docker is dit /data.
# FITS_DATA=./data

# Poort op de server (alleen 127.0.0.1). Standaard 8005; bezet? Kies een vrije.
# FITS_POORT=8006

# Hardlopen (docs/hardlopen.md). Beide optioneel.
# Map met ruwe loopbestanden / Strava-export. Standaard <FITS_DATA>/sporen.
# FITS_SPOREN=
# Eigen Overpass-server voor het wegennet. Standaard overpass-api.de met een mirror als reserve.
# OVERPASS_URL=
